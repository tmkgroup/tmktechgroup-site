---
import '../styles/global.css';
import MonitorSmartphone from '@lucide/astro/icons/monitor-smartphone';
import Gamepad2 from '@lucide/astro/icons/gamepad-2';
import BrainCircuit from '@lucide/astro/icons/brain-circuit';
import Building from '@lucide/astro/icons/building';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Clapperboard from '@lucide/astro/icons/clapperboard';
import MapIcon from '@lucide/astro/icons/map';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import Mail from '@lucide/astro/icons/mail';
import { t, industries, contactEmail, privacyUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];
const icons = {
  'monitor-smartphone': MonitorSmartphone,
  'gamepad-2': Gamepad2,
  'brain-circuit': BrainCircuit,
  building: Building,
  'graduation-cap': GraduationCap,
  'shield-check': ShieldCheck,
  clapperboard: Clapperboard,
  map: MapIcon,
};
const site = 'https://tmktechgroup.com';
const canonical = `${site}/`;
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (function () {
        var s = localStorage.getItem('theme');
        var d = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', d ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class="wrap flex items-center justify-between gap-6 py-6">
      <a href="/" class="text-lg font-semibold no-underline tracking-tight">TMK Tech Group</a>
      <nav class="flex items-center gap-5 text-[0.95rem]">
        <a href="#about" class="hidden no-underline hover:underline sm:inline">{c.nav.about}</a>
        <a href="#industries" class="hidden no-underline hover:underline sm:inline">{c.nav.industries}</a>
        <a href="#contact" class="hidden no-underline hover:underline sm:inline">{c.nav.contact}</a>
        <button id="theme" type="button" aria-label={c.themeLabel} title={c.themeLabel}
          class="grid size-9 cursor-pointer place-items-center rounded-full border border-[var(--line)] bg-transparent text-[var(--ink)]">
          <Sun class="theme-sun" size={18} aria-hidden="true" />
          <Moon class="theme-moon" size={18} aria-hidden="true" />
        </button>
      </nav>
    </header>

    <main>
      <section class="wrap pb-14 pt-16 sm:pt-24">
        <h1 class="m-0 max-w-[11ch] text-[clamp(3rem,9.5vw,8.25rem)] font-semibold leading-[0.95] tracking-[-0.035em]">
          {c.hero.title}
        </h1>
        <p class="measure mt-10 mb-0 text-[clamp(1.2rem,2vw,1.5rem)] leading-snug">{c.hero.lead}</p>
        <p class="measure mt-3 mb-0 text-[var(--muted)]">{c.hero.sub}</p>
      </section>

      <div class="band" aria-label={c.industriesSection.title}>
        <div class="band-track">
          <ul>
            {industries.map((i) => { const I = icons[i.icon]; return <li><I size={22} aria-hidden="true" />{i.name}</li>; })}
          </ul>
          <ul aria-hidden="true">
            {industries.map((i) => { const I = icons[i.icon]; return <li><I size={22} aria-hidden="true" />{i.name}</li>; })}
          </ul>
        </div>
      </div>

      <section id="about" class="wrap grid gap-8 border-b border-[var(--line)] py-20 md:grid-cols-[1fr_2fr]">
        <h2 class="m-0 text-3xl font-semibold leading-tight tracking-tight">{c.about.title}</h2>
        <div class="measure">
          {c.about.body.map((p) => <p class="mt-0 mb-5">{p}</p>)}
        </div>
      </section>

      <section class="wrap grid gap-12 border-b border-[var(--line)] py-20 md:grid-cols-2">
        <div>
          <h2 class="m-0 text-base font-semibold text-[var(--accent)]">{c.vision.title}</h2>
          <p class="mt-4 mb-0 text-[clamp(1.3rem,2.2vw,1.7rem)] leading-snug">{c.vision.body}</p>
        </div>
        <div>
          <h2 class="m-0 text-base font-semibold text-[var(--accent)]">{c.mission.title}</h2>
          <p class="mt-4 mb-0 text-[clamp(1.3rem,2.2vw,1.7rem)] leading-snug">{c.mission.body}</p>
        </div>
      </section>

      <section class="wrap grid gap-8 border-b border-[var(--line)] py-20 md:grid-cols-[1fr_2fr]">
        <h2 class="m-0 text-3xl font-semibold leading-tight tracking-tight">{c.values.title}</h2>
        <dl class="m-0 grid gap-x-10 gap-y-7 sm:grid-cols-2">
          {c.values.items.map(([k, v]) => (
            <div class="border-t-2 border-[var(--accent)] pt-3">
              <dt class="font-semibold">{k}</dt>
              <dd class="m-0 mt-1 text-[var(--muted)]">{v}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="industries" class="wrap grid gap-8 border-b border-[var(--line)] py-20 md:grid-cols-[1fr_2fr]">
        <div>
          <h2 class="m-0 text-3xl font-semibold leading-tight tracking-tight">{c.industriesSection.title}</h2>
          {c.industriesSection.sub && <p class="mt-3 mb-0 text-[var(--muted)]">{c.industriesSection.sub}</p>}
        </div>
        <ul class="m-0 grid list-none gap-x-10 p-0 sm:grid-cols-2">
          {industries.map((i) => {
            const I = icons[i.icon];
            return (
              <li class="flex items-center gap-4 border-b border-[var(--line)] py-4 font-semibold">
                <I size={24} class="shrink-0 text-[var(--accent)]" aria-hidden="true" />
                {i.name}
              </li>
            );
          })}
        </ul>
      </section>

      <section id="contact" class="wrap py-24">
        <h2 class="m-0 max-w-[16ch] text-[clamp(2.2rem,5vw,4rem)] font-semibold leading-[1.02] tracking-[-0.03em]">{c.contact.title}</h2>
        <a href={`mailto:${contactEmail}`}
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-6 py-3 font-semibold text-[var(--bg)] no-underline hover:opacity-90">
          <Mail size={20} aria-hidden="true" />{contactEmail}
        </a>
      </section>
    </main>

    <footer class="bg-[var(--band-bg)] text-[var(--band-ink)]">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-sm">
        <span class="font-semibold">TMK Tech Group</span>
        <a href={privacyUrl} class="hover:opacity-80">{c.footer.privacy}</a>
        <span>{c.footer.copyright}</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme').addEventListener('click', function () {
        var r = document.documentElement;
        var next = r.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        r.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>
    <style is:global>
      :root[data-theme='dark'] .theme-moon,
      :root:not([data-theme='dark']) .theme-sun { display: none; }
    </style>
  </body>
</html>
